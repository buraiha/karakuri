# Copy to .env and replace placeholders. Never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Default: SQLite. DB_BACKEND accepts sqlite, postgresql, mysql.
DB_BACKEND=sqlite
SQLITE_PATH=.data/db.sqlite3
# Required only for PostgreSQL:
POSTGRES_DB=karakuri
POSTGRES_USER=karakuri
POSTGRES_PASSWORD=replace-with-a-random-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55434
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required only for MySQL (also install requirements-mysql.lock):
MYSQL_DATABASE=karakuri
MYSQL_USER=karakuri
MYSQL_PASSWORD=replace-with-a-random-mysql-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=53306
# Only needed when initializing the optional MySQL container:
MYSQL_ROOT_PASSWORD=replace-with-another-random-mysql-root-password
